# Copy to .env and fill in. `docker compose up` will refuse to start until
# every required value is non-empty — the compose file's `${VAR:?...}`
# directives fail-fast rather than silently running with the upstream
# `myuser/mypassword` example credentials.

# Postgres credentials. Used by both the DB container and Manifest's
# DATABASE_URL. Any value works locally; pick something random for non-loopback.
POSTGRES_USER=manifest
POSTGRES_PASSWORD=
POSTGRES_DB=manifest

# Better Auth JWT/HMAC secret. Generate with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Encryption key for provider API keys at rest. Generate with:
#   openssl rand -hex 32
# Losing this key makes all stored provider credentials undecryptable.
MANIFEST_ENCRYPTION_KEY=

# Public URL where users reach the dashboard. http://localhost:2099 for a
# local single-machine deploy; https://<your-domain> when behind a TLS
# reverse proxy (HSTS is only enabled when this is https://).
BETTER_AUTH_URL=http://localhost:2099

# Generic OIDC login (optional). Set OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and
# OIDC_ISSUER to enable. Callback URL:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/${OIDC_PROVIDER_ID}
# OIDC_PROVIDER_ID=oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=